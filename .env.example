# Optional: a Google Maps JavaScript API key enables the "Google satellite" basemap.
# Leave it empty to use the key-less defaults (Esri World Imagery + AWS Terrain Tiles).
# The key is used directly in the browser, so restrict it by HTTP referrer in Google Cloud
# Console. No Google tiles are scraped, cached or bundled by this project.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: override the Overpass endpoint used for building/road exposure.
# Defaults to the three public mirrors.
VITE_OVERPASS_URL=

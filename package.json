{
  "name": "tankbreach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TankBreach \u2014 tank leak & breach inundation web mapper (screening tool)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && node -e \"const fs = require('fs'); fs.copyFileSync('index.source.html', 'index.html');\" && vite build --outDir docs --emptyOutDir false && node scripts/sync-build.js",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "geotiff": "^2.1.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "maplibre-gl": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
